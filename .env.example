# ============================================================
# AgentNexus Environment Configuration Example
# ============================================================
# Copy this file to .env and configure your secret credentials:
#   cp .env.example .env
#
# IMPORTANT: Never commit your real .env file or credentials to Git!
# ============================================================

# Server Port and Host
PORT=3050
HOST=127.0.0.1
NODE_ENV=production

# Authentication Credentials
# Master account credentials for web panel access
APP_LOGIN=admin
APP_PASSWORD=your_secure_password_here

# AI Provider Keys (Optional)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# CLI Binary Path Overrides (Optional, defaults to ~/.local/bin)
# AGY_BIN_PATH=/home/alex/.local/bin/agy
# CLAUDE_BIN_PATH=/home/alex/.local/bin/claude
